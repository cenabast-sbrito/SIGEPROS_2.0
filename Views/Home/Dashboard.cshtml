@{
    string imagen = "";
    string img_pnacpacam = "../images/portada PNACPACAM.png";
    string img_pni = "../images/portada PNI.png";
}


@if (User.HasClaim("Programa_0", "Administra"))
{
        <img class="fondo-programa"  src="@img_pnacpacam" />
}

@if (User.HasClaim("Programa_0", "Consulta"))
{
        <img class="fondo-programa"  src="@img_pnacpacam" />
}
@if (User.HasClaim("Programa_1", "Administra"))
{
        <img class="fondo-programa"  src="@img_pni" />
}

@if (User.HasClaim("Programa_1", "Consulta"))
{
        <img class="fondo-programa"  src="@img_pni" />
}

