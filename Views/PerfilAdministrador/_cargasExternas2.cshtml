<style>

    /* oculto el input real */
    #file-upload {
        display: none;
    }

    .file-upload-container {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 5px;
    }

    .file-upload-btn {
        margin: 0;
        padding: 10px 16px;
        background: #006FB3;
        color: #fff;
       /* border-radius: 6px; */
        cursor: pointer;
        font-weight: 600;
        transition: .2s;
    }

        .file-upload-btn:hover {
            background: #005791;
        }

        .file-upload-btn i {
            margin-right: 6px;
        }

    .file-upload-name {
        color: #eee; /*#666;*/
        font-size: 13px;
        font-weight: 600;
        padding: 7px;
        border-bottom: 1px solid;
        background: #343a40;
    }

</style>

